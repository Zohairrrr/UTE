    {
      "parameters": {
        "model": "gpt-4o-mini",
        "prompt": "Analyze this bank transfer receipt screenshot and extract the following fields in JSON format:\n{\n  \"amount\": integer (total amount paid in PKR),\n  \"transactionId\": string (unique reference or transaction ID),\n  \"status\": \"SUCCESS\" | \"FAILED\" | \"PENDING\",\n  \"date\": string (date of transaction)\n}\nReturn ONLY the JSON object, nothing else.",
        "options": {}
      },
      "id": "4e72390f-9025-4c07-88d4-53907cbf66aa",
      "name": "OpenAI Vision OCR",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [
        640,
        300
      ],
      "credentials": {
        "openAiApi": {
          "id": "YOUR_OPENAI_CREDENTIALS_ID",
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const ocrData = JSON.parse($input.first().json.message.content.trim());\nconst expectedAmount = parseInt($node[\"Next.js Webhook Trigger (payment.submitted)\"].json.body.data.amount);\n\nconst matches = ocrData.amount === expectedAmount && ocrData.status === 'SUCCESS';\n\nreturn {\n  matches,\n  ocrAmount: ocrData.amount,\n  expectedAmount,\n  transactionId: ocrData.transactionId,\n  ocrStatus: ocrData.status\n};"
      },
      "id": "ef5ad4c2-9cf5-4cf5-b108-9df2c2f6d0aa",
      "name": "Verify Match logic",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        860,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "type": "boolean"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.matches }}",
              "rightValue": true,
              "operator": "true"
            }
          ],
          "combinator": "and"
        }
      },
      "id": "cf6d62ea-630e-4361-9c60-c3d5ff649d2a",
      "name": "If Match",
