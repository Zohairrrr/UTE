{
  "name": "Urban Tiffin - WhatsApp & Status Notifications",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "urban-tiffin-events",
        "options": {}
      },
      "id": "1d8bf624-9df0-4b5c-b17b-d45e9a4f6eb8",
      "name": "Next.js Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "={{ $json.body.event }}",
                  "type": "string"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.body.event }}",
                    "rightValue": "payment.submitted",
                    "operator": "equal"
                  }
                ],
                "combinator": "and"
              },
              "renameKeys": {},
              "outputIndex": 0
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "={{ $json.body.event }}",
                  "type": "string"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.body.event }}",
                    "rightValue": "payment.approved",
                    "operator": "equal"
                  }
                ],
                "combinator": "and"
              },
              "renameKeys": {},
              "outputIndex": 1
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "={{ $json.body.event }}",
                  "type": "string"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.body.event }}",
                    "rightValue": "payment.rejected",
                    "operator": "equal"
                  }
                ],
                "combinator": "and"
              },
              "renameKeys": {},
              "outputIndex": 2
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "={{ $json.body.event }}",
                  "type": "string"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.body.event }}",
                    "rightValue": "delivery.updated",
                    "operator": "equal"
                  }
                ],
                "combinator": "and"
              },
              "renameKeys": {},
              "outputIndex": 3
            }
          ]
        }
      },
      "id": "e95cfc9d-d816-43b6-9df9-598d9e8460bb",
      "name": "Route Event Type",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [
        470,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v18.0/YOUR_PHONE_NUMBER_ID/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "oAuth2",
        "sendHeaders": true,
        "headers": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR_META_ACCESS_TOKEN"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "messaging_product",
              "value": "whatsapp"
            },
            {
              "name": "to",
              "value": "={{ $json.body.data.customerPhone }}"
            },
            {
              "name": "type",
              "value": "template"
            },
            {
              "name": "template",
              "value": "={ \"name\": \"payment_received_tiffin\", \"language\": { \"code\": \"en_US\" } }"
            }
          ]
        },
        "options": {}
      },
      "id": "5fa23d1b-5e60-496a-85d1-12c8bbf9d0ef",
      "name": "Send Receipt Upload Confirmation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        750,
