            {
              "name": "type",
              "value": "template"
            },
            {
              "name": "template",
              "value": "={ \"name\": \"payment_approved_tiffin\", \"language\": { \"code\": \"en_US\" }, \"components\": [ { \"type\": \"body\", \"parameters\": [ { \"type\": \"text\", \"text\": \"{{ $json.body.data.customerName }}\" }, { \"type\": \"text\", \"text\": \"{{ $json.body.data.approvedDeliverySlot }}\" } ] } ] }"
            }
          ]
        },
        "options": {}
      },
